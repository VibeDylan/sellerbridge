# Copy this file to .env and fill in real values. .env itself is gitignored.

# Mongo root credentials (used by docker-compose.yml and both Mongo connection strings below)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=

# One Mongo container, one database per service (see root README — "database per service")
MONGODBSELLER_URI=mongodb://root:password@localhost:27017/seller-service?authSource=admin
MONGODBKYB_URI=mongodb://root:password@localhost:27017/kyb-service?authSource=admin

# Redpanda (Kafka-compatible broker), external listener — see docker-compose.yml
KAFKA_BROKERS=localhost:19092

# Path to a GCP service account JSON key (analytics-sink only).
# Keep the actual key file under secrets/ at the repo root — that folder is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sellerbridge/secrets/your-key.json
